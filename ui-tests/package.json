{
  "name": "jupyterlite-terminal-ui-tests",
  "version": "1.0.0",
  "description": "JupyterLab jupyterlite-terminal Integration Tests",
  "private": true,
  "scripts": {
    "build": "jlpm clean && python build.py",
    "clean": "rimraf cockle_wasm_env dist .cockle_temp .jupyterlite.doit.db",
    "start": "concurrently 'npm run start:simple' 'npm run start:coi'",
    "start:simple": "npx static-handler -p 8000 ./dist",
    "start:coi": "npx static-handler --coi -p 8001 ./dist",
    "test": "jlpm playwright test",
    "test:ui": "jlpm playwright test --ui",
    "test:update": "jlpm playwright test --update-snapshots"
  },
  "devDependencies": {
    "@jupyterlab/galata": "^5.6.1",
    "@playwright/test": "^1.57.0",
    "concurrently": "^10.0.3",
    "rimraf": "^6.0.1"
  }
}
